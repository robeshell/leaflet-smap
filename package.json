{
  "name": "smap-leaflet-monorepo",
  "private": true,
  "type": "module",
  "description": "smap-leaflet 及其 Vue 封装",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build -w smap-leaflet && npm run build -w smap-leaflet-vue",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build -w smap-leaflet && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "example": "npm run dev -w smap-leaflet-example"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.8",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.10",
    "sass": "^1.71.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0"
  }
}
